# Copy this file to .env and fill in real values. Never commit .env.

# Database (async SQLAlchemy engine — asyncpg driver)
# Local default matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:15432/interviews

# Google Gemini API key (required — see README for how to obtain one)
GOOGLE_API_KEY=

# ElevenLabs API key (optional, used for higher-quality TTS)
ELEVENLABS_API_KEY=

# Browser origins allowed to call this API (comma-separated).
# Defaults to the local Next.js dev server if unset.
CORS_ORIGINS=http://localhost:3000
